# The phone's own health suite, as postmarketOS takes it: lpoco-health (the runner), the generic checks
# and their words, and the timer that runs them 120 s after every boot. A phone's own checks and what its
# manifest expects of it (/etc/lpoco-health/health.env) are the lab's, put by devlab. Published by the package
# conveyor (packaging/conveyor.toml): pkgver and the checksums are filled in for each release tag.
# Origin: written in this repository (linux-phone-oco/lab-tools), source at the release tag below
pkgname=lpoco-health
pkgver=0.1.0
pkgrel=0
pkgdesc="The phone's health: scheduled tests, their results, and switches with reasons (linux-phone-oco)"
replaces="devlab-health"
provides="devlab-health=$pkgver-r$pkgrel"
url="https://github.com/linux-phone-oco/lab-tools"
arch="aarch64 x86_64"
license="MIT OR Apache-2.0"
makedepends="cargo"
options="net !check"
source="$pkgname-$pkgver.tar.gz::https://github.com/linux-phone-oco/lab-tools/archive/refs/tags/lpoco-health-v$pkgver.tar.gz"
builddir="$srcdir/lab-tools-lpoco-health-v$pkgver"

build() {
	cargo build --release --locked -p lpoco-health
}

package() {
	install -Dm755 target/release/lpoco-health "$pkgdir"/usr/bin/lpoco-health
	install -Dm644 health/suite/lib.sh "$pkgdir"/usr/lib/lpoco-health/lib.sh
	for f in health/suite/checks/*/*.sh health/suite/conditions/*.sh; do
		install -Dm644 "$f" "$pkgdir/usr/lib/lpoco-health/${f#health/suite/}"
	done
	install -Dm644 health/suite/lpoco-health.service "$pkgdir"/usr/lib/systemd/system/lpoco-health.service
	install -Dm644 health/suite/lpoco-health.timer "$pkgdir"/usr/lib/systemd/system/lpoco-health.timer
	install -Dm644 health/suite/lpoco-awake.service "$pkgdir"/usr/lib/systemd/system/lpoco-awake.service
	# the names the phone's own checks used before the rename, until they call the new ones
	mkdir -p "$pkgdir"/usr/lib/devlab
	ln -s ../lpoco-health "$pkgdir"/usr/lib/devlab/health
	ln -s lpoco-health "$pkgdir"/usr/bin/devlab-health
}

sha512sums=""
